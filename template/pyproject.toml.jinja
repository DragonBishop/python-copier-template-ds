[project]
name = "{{ module_name }}"
description = "Add your description here"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [{ name = "DragonBishop", email = "276789280+DragonBishop@users.noreply.github.com" }]
license = "MIT"
classifiers = [
  "License :: OSI Approved :: MIT License",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: {{ python_version.split('.')[0] }}.{{ python_version.split('.')[1] }}",
]
dependencies = [
{%- if 'notebooks' in structure %}
  "ipykernel>=6.29.5",
{%- endif %}
]
dynamic = ["version"]

[dependency-groups]
dev = [
  "pytest>=9.1.1",
  "pytest-cov>=7.1.0",
{%- if 'notebooks' in structure %}
  "nbwipers>=0.7.1",
{%- endif %}
  "prek>=0.5.0",
]
lint = [
  "ruff>=0.16.5",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.coverage.report]
exclude_also = [
  "def __repr__",
  "if self.debug:",
  "if settings.DEBUG",
  "raise AssertionError",
  "raise NotImplementedError",
  "if 0:",
  "if __name__ == .__main__.:",
  "if TYPE_CHECKING:",
  'class .*\bProtocol\):',
  '@(abc\.)?abstractmethod',
]

[tool.hatch.version]
path = "src/{{ module_name }}/__init__.py"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ module_name }}"]

[tool.hatch.build.targets.sdist]
exclude = [
{%- if 'notebooks' in structure %}
  "*.ipynb",
{%- endif %}
  ".venv",
  "uv.lock",
]
{% if 'notebooks' in structure %}
[tool.nbwipers]
strip-kernel-info = true
{% endif -%}
{% if 'rumdl' in tooling %}
[tool.rumdl]
disable = ["MD013"]
exclude = ["CHANGELOG.md"]

[tool.rumdl.MD024]
siblings-only = true
{% endif %}
[tool.uv]
# 7-day supply-chain cooldown, first in tool.uv for Semgrep
exclude-newer = "7 days"
default-groups = ["dev"]
