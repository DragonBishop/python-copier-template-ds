repos:
-   repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
    -   id: trailing-whitespace
    -   id: end-of-file-fixer
    -   id: check-yaml
    -   id: check-merge-conflict
-   repo: https://github.com/astral-sh/ruff-pre-commit
    # Ruff version.
    rev: v0.15.6
    hooks:
      # Run the linter.
    -   id: ruff
        types_or: [python, pyi, jupyter]
        # Run the formatter.
    -   id: ruff-format
        types_or: [python, pyi, jupyter]
-   repo: https://github.com/felixgwilliams/nbwipers-pre-commit
    rev: v0.6.1
    hooks:
    -   id: nbwipers-check-install
    -   id: nbwipers-large-files
-   repo: https://github.com/crate-ci/typos
    rev: v1.44.0
    hooks:
    -   id: typos{% if use_rumdl %}
-   repo: https://github.com/rvben/rumdl-pre-commit
    rev: v0.1.58
    hooks:
      - id: rumdl      # Lint only (fails on issues)
      - id: rumdl-fmt  # Auto-format and fail if issues remain{% else %}
-   repo: https://github.com/DavidAnson/markdownlint-cli2
    rev: v0.21.0
    hooks:
    -   id: markdownlint-cli2{% endif %}
