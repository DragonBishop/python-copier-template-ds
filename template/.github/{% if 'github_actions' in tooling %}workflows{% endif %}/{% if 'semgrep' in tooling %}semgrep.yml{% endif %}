on:
  workflow_dispatch: {}
  pull_request: {}
  push:
    branches:
    - main
    paths:
    - .github/workflows/semgrep.yml
  schedule:
  # random HH:MM to avoid a load spike on GitHub Actions at 00:00
  - cron: 5 12 * * *
name: Semgrep
jobs:
  semgrep:
    name: semgrep/ci
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      SEMGREP_APP_TOKEN: ${{ secrets.SEMGREP_APP_TOKEN }}
    container:
      image: semgrep/semgrep:1.180.0
    steps:
    - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
    - name: Scan with Semgrep AppSec Platform policies
      if: env.SEMGREP_APP_TOKEN != ''
      run: semgrep ci
    # forks and repos without the secret still get a real scan
    - name: Scan with Semgrep Registry rules
      if: env.SEMGREP_APP_TOKEN == ''
      env:
        SEMGREP_RULES: p/default p/github-actions
      run: |
        echo "::notice::SEMGREP_APP_TOKEN is not set; scanning with Semgrep Registry rules (p/default, p/github-actions)."
        semgrep ci
