module_name := "{{ module_name }}"

# list commands
default:
  @just --list

# install the packages
install:
  {% raw %}{{ if path_exists("uv.lock") == "true" { "uv sync --all-groups --all-extras --locked --inexact" } else { "uv sync --all-groups --all-extras --inexact" } }}{% endraw %}

# setup for development
setup: install git-setup

# run test coverage and create
test-cov:
  uv run pytest --cov=src/{{ module_name }} --cov-report=lcov:lcov.info --cov-report=term-missing --cov-report html --cov-report xml

# update packages and uv lock file
update:
  uv sync -U --all-groups --all-extras --inexact

# set up {% if 'notebooks' in structure %}git filters (nbwipers) and {% endif %}pre-commit hooks
git-setup:
  @[ -d .git ] || git init -b main
{%- if 'notebooks' in structure %}
  uv run nbwipers install local
{%- endif %}
  uv run prek install
